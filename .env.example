DATABASE_URL=your-postgres-connection-string-here
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_BUCKET_NAME=your-bucket-name
OPENAI_API_KEY=your-openai-api-key-here

# ──────────────────────────────────────────────────────────────────────────────
# Green Button Utility Data Integration
# ──────────────────────────────────────────────────────────────────────────────

# SDG&E Connect My Data (CMD) - Direct Green Button OAuth
# Obtain credentials from SDG&E developer portal after application approval
SDGE_CMD_CLIENT_ID=your-sdge-cmd-client-id
SDGE_CMD_CLIENT_SECRET=your-sdge-cmd-client-secret
SDGE_CMD_REDIRECT_URI=https://your-app.com/api/utility/callback
SDGE_CMD_BASE_URL=https://api.sdge.com/greenbutton
SDGE_CMD_AUTH_URL=https://myaccount.sdge.com/portal/oauth/authorize
SDGE_CMD_TOKEN_URL=https://api.sdge.com/oauth/token

# UtilityAPI (Fallback Aggregator)
# Sign up at https://utilityapi.com for API access
UTILITYAPI_API_KEY=your-utilityapi-api-key 
UTILITYAPI_BASE_URL=https://utilityapi.com/api/v2
UTILITYAPI_WEBHOOK_SECRET=your-utilityapi-webhook-secret

# Token Encryption
# Generate a secure 32-byte key: python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# ──────────────────────────────────────────────────────────────────────────────
# Enphase Solar Monitoring Integration
# ──────────────────────────────────────────────────────────────────────────────

# Enphase Developer API v4 OAuth credentials
# Register at https://developer-v4.enphase.com to obtain credentials
# Required scopes: read (for system discovery and telemetry)
ENPHASE_CLIENT_ID=your-enphase-client-id
ENPHASE_CLIENT_SECRET=your-enphase-client-secret

# Enphase API Key - separate from OAuth credentials
# Found in developer portal under your application's API keys
ENPHASE_API_KEY=your-enphase-api-key

# OAuth callback URL - must match what's registered in Enphase developer portal
# Format: https://your-app.com/api/enphase/oauth/callback
ENPHASE_REDIRECT_URI=https://your-app.com/api/enphase/oauth/callback